# Physical machines: keep predictable NIC names (enp3s0 etc.), DHCP by default.
# Static addressing can be layered on later via files/etc/network/interfaces/<HOSTNAME>.
MODULESLIST=""

# Standalone ISO installs have no FAI server to receive logs or update PXE
# configuration. Keep local install logs, and preserve remote logging for PXE.
if [ -z "$SERVER" ]; then
    FAI_LOGPROTO=none
fi

# Recent physical NICs (including RTL8127) need the backports kernel.
kernelname=${kernelname}/trixie-backports
