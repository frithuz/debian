grub_apparmor() {
    [ -r "$grub_cfg" ] || { echo "cannot read /boot/grub/grub.cfg"; return 1; }
    local bad; bad=$(awk '/^[ \t]*linux[ \t]/ && !/memtest/ && !(/apparmor=1/ && /security=apparmor/)' "$grub_cfg" | head -1)
    [ -z "$bad" ] || { echo "kernel line without apparmor=1 security=apparmor"; return 1; }
}
check 1.3.1.2 "AppArmor enabled in the bootloader" grub_apparmor
aa_profiles() {
    local out n; out=$(aa-status 2>&1) || { echo "aa-status failed"; return 1; }
    n=$(awk '/processes are unconfined but have a profile defined/ {print $1}' <<< "$out")
    [ "${n:-0}" = 0 ] || { echo "$n processes unconfined despite a profile"; return 1; }
}
live_only 1.3.1.3 "AppArmor profiles in enforce or complain mode" && check 1.3.1.3 "AppArmor profiles in enforce or complain mode" aa_profiles

grub_password() {
    [ -r "$grub_cfg" ] || { echo "cannot read /boot/grub/grub.cfg"; return 1; }
    grep -Eq '^[[:space:]]*set[[:space:]]+superusers=' "$grub_cfg" && grep -Eq '^[[:space:]]*password_pbkdf2[[:space:]]' "$grub_cfg" \
        || { echo "no superusers/password_pbkdf2 in grub.cfg"; return 1; }
}
check 1.4.1 "bootloader password set" grub_password
check 1.4.2 "bootloader config permissions" perm /boot/grub/grub.cfg 600

check 1.5.1 "ASLR enabled" sysctl_is kernel.randomize_va_space 2
ptrace_ok() { local v; v=$(sysctl_get kernel.yama.ptrace_scope); [[ $v =~ ^[123]$ ]] || { echo "kernel.yama.ptrace_scope = ${v:-unset}"; return 1; }; }
check 1.5.2 "ptrace_scope restricted" ptrace_ok
core_ok() {
    cat "$R"/etc/security/limits.conf "$R"/etc/security/limits.d/*.conf 2>/dev/null \
        | grep -Eq '^[[:space:]]*\*[[:space:]]+hard[[:space:]]+core[[:space:]]+0\b' || { echo "no '* hard core 0'"; return 1; }
    sysctl_is fs.suid_dumpable 0 || return 1
    if installed systemd-coredump; then
        [ "$(conf_get Storage "$R/etc/systemd/coredump.conf" "$R"/etc/systemd/coredump.conf.d/*.conf)" = none ] || { echo "systemd-coredump stores dumps"; return 1; }
    fi
}
