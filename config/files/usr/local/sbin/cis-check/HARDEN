defs="$R/etc/login.defs"
users_with_pw() { awk -F: '$2 ~ /^\$/' "$R/etc/shadow"; }
max_days() {
    local v; v=$(conf_get PASS_MAX_DAYS "$defs"); num_between "$v" 1 365 || { echo "PASS_MAX_DAYS $v"; return 1; }
    local bad; bad=$(users_with_pw | awk -F: '$5 == "" || $5 > 365 || $5 < 1 {print $1; exit}'); [ -z "$bad" ] || { echo "user $bad max days > 365"; return 1; }
}
warn_age() { local v; v=$(conf_get PASS_WARN_AGE "$defs"); num_between "$v" 7 999 || { echo "PASS_WARN_AGE $v"; return 1; }; }
enc_method() { local v; v=$(conf_get ENCRYPT_METHOD "$defs"); [[ ${v^^} =~ ^(SHA512|YESCRYPT)$ ]] || { echo "ENCRYPT_METHOD $v"; return 1; }; }
inactive() {
    local v; v=$(awk -F= '$1=="INACTIVE" {print $2}' "$R/etc/default/useradd" 2>/dev/null); num_between "${v:--1}" 0 45 || { echo "useradd INACTIVE=${v:--1}"; return 1; }
    local bad; bad=$(users_with_pw | awk -F: '$7 == "" || $7 > 45 || $7 < 0 {print $1; exit}'); [ -z "$bad" ] || { echo "user $bad inactive > 45"; return 1; }
}
pw_past() { local today bad; today=$(( $(date +%s) / 86400 )); bad=$(users_with_pw | awk -F: -v t="$today" '$3 > t {print $1; exit}'); [ -z "$bad" ] || { echo "user $bad changed password in the future"; return 1; }; }
check 5.4.1.1 "password expiration <= 365 days" max_days
manual 5.4.1.2 "minimum password days" "Level 2"
check 5.4.1.3 "password expiration warning >= 7 days" warn_age
check 5.4.1.4 "strong password hashing algorithm" enc_method
check 5.4.1.5 "inactive password lock <= 45 days" inactive
check 5.4.1.6 "all users' last password change in the past" pw_past

only_root_uid0() { local u; u=$(awk -F: '$3 == 0 && $1 != "root" {print $1}' "$R/etc/passwd"); [ -z "$u" ] || { echo "UID 0: $u"; return 1; }; }
only_root_gid0() { local u; u=$(awk -F: '$4 == 0 && $1 !~ /^(root|sync|shutdown|halt|operator)$/ {print $1}' "$R/etc/passwd"); [ -z "$u" ] || { echo "primary GID 0: $u"; return 1; }; }
group_root_only() { local g; g=$(awk -F: '$3 == 0 && $1 != "root" {print $1}' "$R/etc/group"); [ -z "$g" ] || { echo "GID 0 group: $g"; return 1; }; }
root_access() { local f; f=$(awk -F: '$1=="root" {print $2}' "$R/etc/shadow"); [[ $f == '!'* || $f == '*'* || $f == '$'* ]] || { echo "root has no password and is not locked"; return 1; }; }
root_path() {
    local d P=$CALLER_PATH; IFS=: read -ra ds <<< "$P"
    [[ $P != *::* && $P != :* && $P != *: ]] || { echo "empty entry in PATH"; return 1; }
    for d in "${ds[@]}"; do
        [ "$d" != . ] || { echo ". in PATH"; return 1; }
        [ -d "$d" ] || continue
        perm "$d" 755 >/dev/null || { echo "$d in PATH is not root-owned 755"; return 1; }
    done
}
umask_ok() { local u=$((8#$1)); (( (u & 8#027) == 8#027 )); }
root_umask() {
    local f u; for f in /root/.bash_profile /root/.bashrc /root/.profile; do
        [ -f "$R$f" ] || continue
        while read -r u; do umask_ok "$u" || { echo "$f sets umask $u"; return 1; }; done < <(grep -oE '^[[:space:]]*umask[[:space:]]+[0-7]+' "$R$f" | awk '{print $2}')
    done
}
uid_min=$(conf_get UID_MIN "$defs"); uid_min=${uid_min:-1000}
valid_shells() { grep -Ev '^[[:space:]]*(#|$)' "$R/etc/shells" | grep -v nologin; }
sys_no_shell() {
    local bad; bad=$(awk -F: -v m="$uid_min" -v shells="$(valid_shells | tr '\n' ' ')" '
        BEGIN { n=split(shells, s, " "); for (i=1;i<=n;i++) ok[s[i]]=1 }
        $3 < m && $1 !~ /^(root|halt|sync|shutdown|nfsnobody)$/ && ($7 in ok) {print $1; exit}' "$R/etc/passwd")
    [ -z "$bad" ] || { echo "system account $bad has a login shell"; return 1; }
}
noshell_locked() {
    local u; for u in $(awk -F: -v shells="$(valid_shells | tr '\n' ' ')" '
        BEGIN { n=split(shells, s, " "); for (i=1;i<=n;i++) ok[s[i]]=1 }
        $1 != "root" && !($7 in ok) {print $1}' "$R/etc/passwd"); do
        local f; f=$(awk -F: -v u="$u" '$1==u {print $2}' "$R/etc/shadow")
        [[ $f == '!'* || $f == '*'* ]] || { echo "$u has no login shell but is not locked"; return 1; }
    done
}
