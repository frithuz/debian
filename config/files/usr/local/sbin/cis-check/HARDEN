check 7.2.3 "groups in /etc/passwd exist" groups_exist
check 7.2.4 "shadow group is empty" shadow_empty
check 7.2.5 "no duplicate UIDs" no_dups passwd 3
check 7.2.6 "no duplicate GIDs" no_dups group 3
check 7.2.7 "no duplicate user names" no_dups passwd 1
check 7.2.8 "no duplicate group names" no_dups group 1
check 7.2.9 "interactive users' home directories" homes_ok
check 7.2.10 "interactive users' dot files" dotfiles_ok

