sshd_cfg_perm() { local f; for f in /etc/ssh/sshd_config "$R"/etc/ssh/sshd_config.d/*.conf; do f=${f#"$R"}; [ -e "$R$f" ] || continue; perm "$f" 600 || return 1; done; }
