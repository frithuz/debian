check 5.4.2.6 "root umask" root_umask
check 5.4.2.7 "system accounts have no login shell" sys_no_shell
check 5.4.2.8 "accounts without a login shell are locked" noshell_locked
nologin_shells() { ! grep -Eq '/nologin\b' "$R/etc/shells" || { echo "nologin listed in /etc/shells"; return 1; }; }
profile_files() { ls "$R"/etc/profile "$R"/etc/profile.d/*.sh "$R"/etc/bash.bashrc 2>/dev/null; }
tmout_ok() {
    local all; all=$(profile_files | xargs -r cat)
    local v; v=$(grep -oE '^[^#]*\bTMOUT=[0-9]+' <<< "$all" | grep -oE '[0-9]+$' | tail -1)
    num_between "${v:-0}" 1 900 || { echo "TMOUT=${v:-unset}"; return 1; }
    grep -Eq '^[^#]*\breadonly[[:space:]]+TMOUT\b' <<< "$all" || { echo "TMOUT not readonly"; return 1; }
    grep -Eq '^[^#]*\bexport[[:space:]]+TMOUT\b' <<< "$all" || { echo "TMOUT not exported"; return 1; }
}
default_umask() {
    local v; v=$(conf_get UMASK "$defs"); umask_ok "${v:-022}" || { echo "login.defs UMASK ${v:-unset}"; return 1; }
    local f u; for f in $(profile_files); do
        while read -r u; do umask_ok "$u" || { echo "${f#"$R"} sets umask $u"; return 1; }; done < <(grep -oE '^[[:space:]]*umask[[:space:]]+[0-7]+' "$f" | awk '{print $2}')
    done
}
