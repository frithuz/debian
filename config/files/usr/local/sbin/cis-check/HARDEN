fs_find() { # find over local filesystems, skipping pseudo filesystems
    find "$R/" \( -path "$R/proc" -o -path "$R/sys" -o -path "$R/dev" -o -path "$R/run" \
        -o -fstype nfs -o -fstype nfs4 -o -fstype cifs -o -fstype proc -o -fstype sysfs \) -prune -o "$@" 2>/dev/null
}
ww_ok() {
    local f; f=$(fs_find -type f -perm -0002 -print | head -1); [ -z "$f" ] && f=$(fs_find -type d -perm -0002 ! -perm -1000 -print | head -1)
    [ -z "$f" ] || { echo "world-writable without sticky bit: ${f#"$R"}"; return 1; }
}
unowned_ok() {
    local f
    f=$(fs_find -printf '%U %G %p\n' | awk -v pw="$R/etc/passwd" -v gr="$R/etc/group" -v r="$R" '
        BEGIN { FS=":"; while ((getline < pw) > 0) u[$3]=1; while ((getline < gr) > 0) g[$3]=1; FS=" " }
        !($1 in u) || !($2 in g) { sub("^" r, "", $3); print $3; exit }')
    [ -z "$f" ] || { echo "unowned file: $f"; return 1; }
}
check 7.1.11 "world-writable files and directories secured" ww_ok
check 7.1.12 "no files without an owner or group" unowned_ok
manual 7.1.13 "SUID/SGID files reviewed" "$(fs_find -type f \( -perm -4000 -o -perm -2000 \) -print | wc -l) files; review: find / -xdev -perm /6000 -type f"

shadowed() { local u; u=$(awk -F: '$2 != "x" {print $1; exit}' "$R/etc/passwd"); [ -z "$u" ] || { echo "$u has a password in /etc/passwd"; return 1; }; }
no_empty_pw() { local u; u=$(awk -F: '$2 == "" {print $1; exit}' "$R/etc/shadow"); [ -z "$u" ] || { echo "$u has an empty password"; return 1; }; }
groups_exist() { local g; g=$(awk -F: 'NR==FNR {g[$3]=1; next} !($4 in g) {print $1; exit}' "$R/etc/group" "$R/etc/passwd"); [ -z "$g" ] || { echo "$g's primary group does not exist"; return 1; }; }
shadow_empty() {
    local m sg; sg=$(gid_of shadow); m=$(awk -F: '$1=="shadow" {print $4}' "$R/etc/group")
    [ -z "$m" ] || { echo "group shadow has members: $m"; return 1; }
    [ -z "$sg" ] || [ -z "$(awk -F: -v g="$sg" '$4==g' "$R/etc/passwd")" ] || { echo "a user has primary group shadow"; return 1; }
}
no_dups() { local d; d=$(cut -d: -f"$2" "$R/etc/$1" | sort | uniq -d | head -1); [ -z "$d" ] || { echo "duplicate in /etc/$1: $d"; return 1; }; }
interactive_users() { awk -F: -v shells="$(valid_shells | tr '\n' ' ')" -v m="$uid_min" '
    BEGIN { n=split(shells, s, " "); for (i=1;i<=n;i++) ok[s[i]]=1 } ($7 in ok) && ($3 >= m || $1 == "root") {print $1":"$3":"$6}' "$R/etc/passwd"; }
homes_ok() {
    local u uid h m o; while IFS=: read -r u uid h; do
        [ -d "$R$h" ] || { echo "$u home $h missing"; return 1; }
        read -r m o < <(stat -c '%a %u' "$R$h")
        [ "$o" = "$uid" ] || { echo "$h not owned by $u"; return 1; }
        (( (8#$m & ~8#750) == 0 )) || { echo "$h mode $m > 750"; return 1; }
    done < <(interactive_users)
}
dotfiles_ok() {
    local u uid h f m; while IFS=: read -r u uid h; do
        for f in "$R$h"/.forward "$R$h"/.rhosts; do [ ! -e "$f" ] || { echo "${f#"$R"} exists"; return 1; }; done
        [ ! -e "$R$h/.netrc" ] || perm "$h/.netrc" 600 "$u" "$(id -gn "$u" 2>/dev/null || echo "$u")" >/dev/null || { echo "$h/.netrc too open"; return 1; }
        [ ! -e "$R$h/.bash_history" ] || (( (8#$(stat -c %a "$R$h/.bash_history") & ~8#600) == 0 )) || { echo "$h/.bash_history mode > 600"; return 1; }
        for f in "$R$h"/.[!.]*; do
            [ -f "$f" ] || continue; m=$(stat -c %a "$f")
            (( (8#$m & 8#022) == 0 )) || { echo "${f#"$R"} is group/world-writable"; return 1; }
        done
    done < <(interactive_users)
}
