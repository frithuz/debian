unix_lines() { cat "$(pam_file common-auth)" "$(pam_file common-account)" "$(pam_file common-password)" "$(pam_file common-session)" 2>/dev/null | grep -E '^[^#]*pam_unix\.so'; }
unix_no() { ! unix_lines | grep -Eq "\b$1" || { echo "pam_unix uses $1"; return 1; }; }
unix_pw() { grep -E '^[^#]*password.*pam_unix\.so' "$(pam_file common-password)" 2>/dev/null | grep -Eq "$1" || { echo "pam_unix password line lacks $2"; return 1; }; }
