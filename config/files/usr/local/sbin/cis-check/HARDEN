if installed chrony; then
    chrony_src() { cat "$R/etc/chrony/chrony.conf" "$R"/etc/chrony/conf.d/*.conf "$R"/etc/chrony/sources.d/*.sources 2>/dev/null | grep -Eq '^[[:space:]]*(server|pool|sourcedir)[[:space:]]' || { echo "no server/pool configured"; return 1; }; }
    chrony_user() { local u; u=$(cat "$R/etc/chrony/chrony.conf" "$R"/etc/chrony/conf.d/*.conf 2>/dev/null | awk '$1=="user" {print $2}' | tail -1); [ -z "$u" ] || [ "$u" = _chrony ] || { echo "chronyd runs as $u"; return 1; }; }
