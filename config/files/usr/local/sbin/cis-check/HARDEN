hostkeys() { # 2: private, 3: public
    local f n=0; for f in "$R"/etc/ssh/ssh_host_*_key; do
        [ -e "$f" ] || continue; n=$((n+1))
        if [ "$1" = priv ]; then perm "${f#"$R"}" 600 || perm "${f#"$R"}" 640 root ssh_keys || return 1
        else perm "${f#"$R"}.pub" 644 || return 1; fi
    done
    [ $n -gt 0 ] || [ $LIVE = 0 ] || { echo "no host keys"; return 1; }
}
check 5.1.2 "ssh private host key permissions" hostkeys priv
check 5.1.3 "ssh public host key permissions" hostkeys pub
if sshd_effective; then
    sshd_access() { local k; for k in allowusers allowgroups denyusers denygroups; do [ -n "$(sshd_val $k)" ] && return 0; done; echo "no AllowUsers/AllowGroups/DenyUsers/DenyGroups"; return 1; }
    sshd_banner() { local v; v=$(sshd_val banner); [ -n "$v" ] && [ "$v" != none ] || { echo "no Banner"; return 1; }; }
    sshd_alive() { num_between "$(sshd_val clientaliveinterval)" 1 99999 && num_between "$(sshd_val clientalivecountmax)" 1 99999 || { echo "ClientAliveInterval/CountMax not > 0"; return 1; }; }
    sshd_range() { local v; v=$(sshd_val "$1"); num_between "$v" "$2" "$3" || { echo "$1 is $v, want $2..$3"; return 1; }; }
    sshd_loglevel() { local v; v=$(sshd_val loglevel); [[ ${v^^} =~ ^(INFO|VERBOSE)$ ]] || { echo "LogLevel is $v"; return 1; }; }
    sshd_startups() {
        local v a b c; v=$(sshd_val maxstartups); IFS=: read -r a b c <<< "$v"
        num_between "${a:-99}" 1 10 && num_between "${b:-99}" 1 30 && num_between "${c:-99}" 1 60 || { echo "MaxStartups is $v, want 10:30:60 or stricter"; return 1; }
    }
    check 5.1.4  "sshd access configured" sshd_access
    check 5.1.5  "sshd Banner configured" sshd_banner
    check 5.1.6  "sshd Ciphers: no weak ciphers" sshd_none_of ciphers 3des-cbc aes128-cbc aes192-cbc aes256-cbc rijndael-cbc@lysator.liu.se chacha20-poly1305@openssh.com
    check 5.1.7  "sshd ClientAliveInterval/CountMax" sshd_alive
    check 5.1.8  "sshd DisableForwarding" sshd_is disableforwarding yes
    check 5.1.9  "sshd GSSAPIAuthentication disabled" sshd_is gssapiauthentication no
    check 5.1.10 "sshd HostbasedAuthentication disabled" sshd_is hostbasedauthentication no
    check 5.1.11 "sshd IgnoreRhosts enabled" sshd_is ignorerhosts yes
    check 5.1.12 "sshd KexAlgorithms: no weak kex" sshd_none_of kexalgorithms diffie-hellman-group1-sha1 diffie-hellman-group14-sha1 diffie-hellman-group-exchange-sha1
    check 5.1.13 "sshd LoginGraceTime 1-60s" sshd_range logingracetime 1 60
    check 5.1.14 "sshd LogLevel INFO or VERBOSE" sshd_loglevel
    check 5.1.15 "sshd MACs: no weak MACs" sshd_none_of macs hmac-md5 hmac-md5-96 hmac-ripemd160 hmac-sha1 hmac-sha1-96 umac-64@openssh.com hmac-md5-etm@openssh.com hmac-md5-96-etm@openssh.com hmac-ripemd160-etm@openssh.com hmac-sha1-etm@openssh.com hmac-sha1-96-etm@openssh.com umac-64-etm@openssh.com
    check 5.1.16 "sshd MaxAuthTries <= 4" sshd_range maxauthtries 1 4
    check 5.1.17 "sshd MaxSessions <= 10" sshd_range maxsessions 1 10
    check 5.1.18 "sshd MaxStartups 10:30:60 or stricter" sshd_startups
    check 5.1.19 "sshd PermitEmptyPasswords disabled" sshd_is permitemptypasswords no
    check 5.1.20 "sshd PermitRootLogin disabled" sshd_is permitrootlogin no
    check 5.1.21 "sshd PermitUserEnvironment disabled" sshd_is permituserenvironment no
    check 5.1.22 "sshd UsePAM enabled" sshd_is usepam yes
else
