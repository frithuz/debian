#!/usr/bin/env bash
# cis-check: check this system against the automatable controls of the
# CIS Debian Linux Benchmark, Level 1 - Server.
#
#   sudo cis-check              check the running system
#   cis-check --root /target    check an installed tree (build time, as root);
#                               controls that need the running system are SKIPped
#   --quiet                     print only FAIL and MANUAL lines
#
# Result per control: PASS, FAIL, SKIP (not applicable / needs running system),
# MANUAL (site decision or human review; never fails), EXCEPT (would fail, but is an
# accepted deviation listed in /etc/cis-check/exceptions). Exit 1 if anything FAILs.
#
# Control IDs follow the CIS Debian Linux 12 Benchmark v1.1.0 numbering (the
# Debian 13 benchmark keeps the same structure). This is an independent
# implementation, not CIS-CAT: for a formal audit, run CIS-CAT or your auditor's
# tool against a built machine as well.
#
# Managed by FAI (class HARDEN).

R='' QUIET=0
while [ $# -gt 0 ]; do
    case $1 in
        --root)  R=${2%/}; shift 2 ;;
        --quiet) QUIET=1; shift ;;
        -h|--help) sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "cis-check: unknown argument $1" >&2; exit 2 ;;
    esac
done
LIVE=1; [ -n "$R" ] && LIVE=0
if [ "$(id -u)" != 0 ]; then echo "cis-check: run as root (sudo cis-check)" >&2; exit 2; fi
for f in /etc/shadow /etc/passwd /etc/group /var/lib/dpkg/status; do
    [ -r "$R$f" ] || { echo "cis-check: cannot read $R$f" >&2; exit 2; }
done
# Tools are looked up in sbin regardless of the caller's PATH; the caller's PATH is
# kept for the root PATH integrity check (5.4.2.5).
CALLER_PATH=$PATH
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

np=0 nf=0 ns=0 nm=0 nx=0
EXCEPTIONS=$R/etc/cis-check/exceptions
except_reason() { [ -f "$EXCEPTIONS" ] && awk -v id="$1" '$1 == id { sub(/^[^ \t]+[ \t]+/, ""); print; exit }' "$EXCEPTIONS"; }
pass()   { np=$((np+1)); [ $QUIET = 1 ] || printf 'PASS    %-12s %s\n' "$1" "$2"; }
fail()   { nf=$((nf+1)); printf 'FAIL    %-12s %s%s\n' "$1" "$2" "${3:+  -- $3}"; }
skip()   { ns=$((ns+1)); [ $QUIET = 1 ] || printf 'SKIP    %-12s %s%s\n' "$1" "$2" "${3:+  -- $3}"; }
manual() { nm=$((nm+1)); printf 'MANUAL  %-12s %s%s\n' "$1" "$2" "${3:+  -- $3}"; }
except() { nx=$((nx+1)); printf 'EXCEPT  %-12s %s  -- %s (check says: %s)\n' "$1" "$2" "$3" "$4"; }
# check ID TITLE FUNC [ARGS...]: FUNC prints a reason and returns non-zero on failure
check() {
    local id=$1 title=$2 out reason; shift 2
    if out=$("$@" 2>&1); then pass "$id" "$title"; return; fi
    out=$(printf '%s' "$out" | head -1)
    reason=$(except_reason "$id")
    if [ -n "$reason" ]; then except "$id" "$title" "$reason" "$out"; else fail "$id" "$title" "$out"; fi
}
live_only() { [ $LIVE = 1 ] || { skip "$1" "$2" "needs the running system"; return 1; }; }

# ---------- helpers ----------------------------------------------------------
installed() { [ "$(dpkg-query --admindir="$R/var/lib/dpkg" -W -f='${db:Status-Status}' "$1" 2>/dev/null)" = installed ]; }
not_installed() { local p; for p; do installed "$p" && { echo "$p is installed"; return 1; }; done; return 0; }
all_installed() { local p; for p; do installed "$p" || { echo "$p is not installed"; return 1; }; done; return 0; }

uid_of() { awk -F: -v n="$1" '$1==n {print $3}' "$R/etc/passwd"; }
gid_of() { awk -F: -v n="$1" '$1==n {print $3}' "$R/etc/group"; }

# perm PATH MAXMODE [OWNER [GROUP|GROUP|...]]
perm() {
    local p=$R$1 max=$2 owner=${3:-root} groups=${4:-root} m u g ok=0 grp
    [ -e "$p" ] || { echo "$1 does not exist"; return 1; }
    read -r m u g < <(stat -Lc '%a %u %g' "$p")
    (( (8#$m & ~8#$max) == 0 )) || { echo "$1 mode $m, want $max or stricter"; return 1; }
    [ "$u" = "$(uid_of "$owner")" ] || { echo "$1 owner uid $u, want $owner"; return 1; }
    for grp in ${groups//|/ }; do [ "$g" = "$(gid_of "$grp")" ] && ok=1; done
    [ $ok = 1 ] || { echo "$1 group gid $g, want $groups"; return 1; }
}
perm_if_exists() { [ ! -e "$R$1" ] || perm "$@"; }

unit_state() { # enabled / disabled / masked / static / not-found ...
    if [ $LIVE = 1 ]; then systemctl is-enabled "$1" 2>/dev/null
    else systemctl --root="$R" is-enabled "$1" 2>/dev/null; fi
}
unit_enabled() { local s; s=$(unit_state "$1"); [ "$s" = enabled ] || { echo "$1 is ${s:-not found}"; return 1; }; }
unit_off()     { local s; s=$(unit_state "$1"); case $s in enabled|enabled-runtime|alias) echo "$1 is $s"; return 1 ;; esac; }

# sysctl: running value, or the value the config files would set (last one wins)
sysctl_files() {
    local d f b; declare -A seen
    for d in /etc/sysctl.d /run/sysctl.d /usr/local/lib/sysctl.d /usr/lib/sysctl.d /lib/sysctl.d; do
        for f in "$R$d"/*.conf; do
            [ -e "$f" ] || continue; b=${f##*/}; [ -n "${seen[$b]:-}" ] || seen[$b]=$f
        done
    done
    for b in $(printf '%s\n' "${!seen[@]}" | sort); do echo "${seen[$b]}"; done
    [ -f "$R/etc/sysctl.conf" ] && echo "$R/etc/sysctl.conf"
}
sysctl_get() {
    if [ $LIVE = 1 ]; then cat "/proc/sys/${1//.//}" 2>/dev/null; return; fi
    local k=${1//\//.}
    sysctl_files | xargs -r cat 2>/dev/null | awk -v k="$k" '
        { sub(/^[ \t]*-/, ""); split($0, a, "="); key=a[1]; gsub(/[ \t]/, "", key); gsub("/", ".", key) }
        key == k { v=substr($0, index($0, "=")+1); gsub(/^[ \t]+|[ \t]+$/, "", v); val=v }
        END { print val }'
}
sysctl_is() { local v; v=$(sysctl_get "$1"); [ "$v" = "$2" ] || { echo "$1 = ${v:-unset}, want $2"; return 1; }; }

# mounts
mnt_opts() {
    if [ $LIVE = 1 ]; then findmnt -kno OPTIONS "$1" 2>/dev/null
    else awk -v m="$1" '$1 !~ /^#/ && $2 == m {print $4}' "$R/etc/fstab" | tail -1; fi
}
is_mount() { [ -n "$(mnt_opts "$1")" ]; }
mnt_has() { local o; o=$(mnt_opts "$1"); [[ ,$o, == *,$2,* ]] || { echo "$1 mounted without $2 (${o:-not mounted})"; return 1; }; }
mount_checks() { # ID-PREFIX MOUNTPOINT OPTS...   (IDs: prefix.2, .3, .4 for the options)
    local pre=$1 mp=$2 i=2 o; shift 2
    if ! is_mount "$mp"; then
        for o; do skip "$pre.$i" "$mp has $o" "not a separate partition (that part is Level 2)"; i=$((i+1)); done
        return
    fi
    for o; do check "$pre.$i" "$mp has $o" mnt_has "$mp" "$o"; i=$((i+1)); done
}

# key = value config files (pwquality, faillock, journald, login.defs ...), last wins
conf_get() { # KEY FILE...
    local k=$1; shift
    cat "$@" 2>/dev/null | awk -v k="$k" '
        /^[ \t]*[#;]/ {next}
        { line=$0; sub(/[ \t]*#.*/, "", line) }
        match(line, "^[ \t]*" k "[ \t]*(=|[ \t])") { v=substr(line, RLENGTH+1); gsub(/^[ \t=]+|[ \t]+$/, "", v); val=v; found=1 }
        match(line, "^[ \t]*" k "[ \t]*$") { val="(set)"; found=1 }
        END { if (found) print val }'
}
pwq_files() { echo "$R/etc/security/pwquality.conf"; ls "$R"/etc/security/pwquality.conf.d/*.conf 2>/dev/null; }
jd_files()  { echo "$R/etc/systemd/journald.conf"; ls "$R"/usr/lib/systemd/journald.conf.d/*.conf "$R"/etc/systemd/journald.conf.d/*.conf 2>/dev/null; }
num_between() { [[ $1 =~ ^-?[0-9]+$ ]] && (( $1 >= $2 && $1 <= $3 )); }

# sshd effective config (first value wins, includes resolved)
# Must not run in a subshell (e.g. $(sshd_effective)), or SSHD_T is lost.
SSHD_T='' SSHD_ERR=''
sshd_effective() {
    [ -n "$SSHD_T" ] && return 0
    if [ $LIVE = 1 ]; then
        SSHD_T=$(sshd -T 2>&1) || { SSHD_ERR=$SSHD_T; SSHD_T=''; return 1; }
    else
        SSHD_T=$(chroot "$R" /bin/sh -c 'mkdir -p /run/sshd; d=$(mktemp -d) &&
            ssh-keygen -q -t ed25519 -N "" -f "$d/k" && /usr/sbin/sshd -T -h "$d/k"; rc=$?; rm -rf "$d"; exit $rc' 2>&1) \
            || { SSHD_ERR=$SSHD_T; SSHD_T=''; return 1; }
    fi
}
sshd_val() { printf '%s\n' "$SSHD_T" | awk -v k="$1" '$1 == k { $1=""; sub(/^ /, ""); print; exit }'; }
sshd_is() { local v; v=$(sshd_val "$1"); [ "${v,,}" = "${2,,}" ] || { echo "$1 is '${v}', want '$2'"; return 1; }; }
sshd_none_of() { # KEY WEAK...
    local k=$1 v w; shift; v=$(sshd_val "$k")
    for w; do [[ ,$v, == *,$w,* ]] && { echo "$k allows weak $w"; return 1; }; done; return 0
}

pam_file() { echo "$R/etc/pam.d/$1"; }
pam_line() { grep -E "^[[:space:]]*$1[[:space:]].*$2" "$(pam_file "$3")" 2>/dev/null; } # TYPE MODULE FILE

# nftables ruleset: live from the kernel, else the persistent config
nft_rules() { if [ $LIVE = 1 ]; then nft list ruleset 2>/dev/null; else cat "$R/etc/nftables.conf" 2>/dev/null; fi; }

# ---------- 1 Initial setup ----------------------------------------------------
mod_disabled() {
    local m=$1 cf; cf=$(cat "$R"/etc/modprobe.d/*.conf "$R"/usr/lib/modprobe.d/*.conf 2>/dev/null)
    grep -Eq "^[[:space:]]*install[[:space:]]+${m}[[:space:]]+/(usr/)?bin/(false|true)" <<< "$cf" || { echo "no 'install $m /bin/false'"; return 1; }
    grep -Eq "^[[:space:]]*blacklist[[:space:]]+${m}\b" <<< "$cf" || { echo "no 'blacklist $m'"; return 1; }
    if [ $LIVE = 1 ] && [ -d "/sys/module/${m//-/_}" ]; then echo "$m is loaded"; return 1; fi
}
i=1; for m in cramfs freevxfs hfs hfsplus jffs2; do check "1.1.1.$i" "$m kernel module disabled" mod_disabled $m; i=$((i+1)); done
