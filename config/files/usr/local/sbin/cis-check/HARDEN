log_perms() {
    local f m b
    while read -r m f; do
        b=${f##*/}
        case $b in lastlog*|wtmp*|btmp*) max=664 ;; *) max=640 ;; esac
        (( (8#$m & ~8#$max) == 0 )) || { echo "${f#"$R"} mode $m > $max"; return 1; }
    done < <(find "$R/var/log" -type f -printf '%m %p\n' 2>/dev/null)
}
