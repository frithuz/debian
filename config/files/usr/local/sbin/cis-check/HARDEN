# ---------- 4 Firewall ---------------------------------------------------------
check 4.1.1 "a single firewall utility" not_installed ufw iptables-persistent firewalld
check 4.3.1 "nftables installed" all_installed nftables
nft_table() { nft_rules | grep -Eq '^[[:space:]]*table[[:space:]]' || { echo "no nftables table"; return 1; }; }
nft_chains() { local h; for h in input forward output; do nft_rules | grep -Eq "hook $h\b" || { echo "no base chain for hook $h"; return 1; }; done; }
nft_lo() {
    local r; r=$(nft_rules)
    grep -Eq 'iif "?lo"? accept' <<< "$r" || { echo "no 'iif lo accept'"; return 1; }
    grep -Eq 'ip saddr 127\.0\.0\.0/8 .*drop' <<< "$r" || { echo "no drop for 127.0.0.0/8 from non-loopback"; return 1; }
    grep -Eq 'ip6 saddr ::1 .*drop' <<< "$r" || { echo "no drop for ::1 from non-loopback"; return 1; }
}
nft_deny() { local h; for h in "$@"; do nft_rules | grep -Eq "hook $h\b.*policy drop" || { echo "$h chain policy is not drop"; return 1; }; done; }
check 4.3.4 "nftables table exists" nft_table
check 4.3.5 "nftables base chains exist" nft_chains
