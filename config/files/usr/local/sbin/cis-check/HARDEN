check 5.3.3.2.7 "pwquality enforcing" pwq_nonzero enforcing
pwh_line() { grep -E '^[^#]*pam_pwhistory\.so' "$(pam_file common-password)" 2>/dev/null; }
pwh_remember() { local r; r=$(pwh_line | grep -oE 'remember=[0-9]+' | cut -d= -f2); num_between "${r:-0}" 24 9999 || { echo "remember=${r:-unset}"; return 1; }; }
pwh_opt() { pwh_line | grep -qw "$1" || { echo "pam_pwhistory without $1"; return 1; }; }
check 5.3.3.3.1 "pwhistory remember >= 24" pwh_remember
