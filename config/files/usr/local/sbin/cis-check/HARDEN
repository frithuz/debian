check 5.3.2.4 "pam_pwhistory enabled" in_pam pam_pwhistory common-password
fl_conf="$R/etc/security/faillock.conf"
fl_deny() { local v; v=$(conf_get deny "$fl_conf"); num_between "${v:-3}" 1 5 || { echo "deny = $v"; return 1; }; ! grep -Eq 'pam_faillock\.so.*\bdeny=([6-9]|[1-9][0-9])' "$(pam_file common-auth)" || { echo "pam line sets deny > 5"; return 1; }; }
fl_unlock() { local v; v=$(conf_get unlock_time "$fl_conf"); v=${v:-600}; [ "$v" = 0 ] || num_between "$v" 900 999999 || { echo "unlock_time = $v"; return 1; }; }
check 5.3.3.1.1 "faillock deny <= 5" fl_deny
check 5.3.3.1.2 "faillock unlock_time 0 or >= 900" fl_unlock
# shellcheck disable=SC2046 # pwq_files lists files, split on purpose
pwq() { conf_get "$1" $(pwq_files); }
pwq_range() { local v; v=$(pwq "$1"); num_between "${v:-$4}" "$2" "$3" || { echo "$1 = ${v:-default $4}"; return 1; }; }
pwq_complex() { local v; v=$(pwq minclass); num_between "${v:-0}" 4 4 || { echo "minclass = ${v:-0}, want 4"; return 1; }; }
pwq_nonzero() { local v; v=$(pwq "$1"); [ "${v:-1}" != 0 ] || { echo "$1 = 0"; return 1; }; }
check 5.3.3.2.1 "pwquality difok >= 2" pwq_range difok 2 999 1
check 5.3.3.2.2 "pwquality minlen >= 14" pwq_range minlen 14 999 8
