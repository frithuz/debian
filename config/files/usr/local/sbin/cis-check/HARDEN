banner_ok() {
    local f=$R$1; [ -f "$f" ] || return 0
    grep -Eq '\\[mrsv]' "$f" && { echo "$1 contains \\m \\r \\s or \\v"; return 1; }
    grep -qi debian "$f" && { echo "$1 names the OS"; return 1; }
    return 0
}
