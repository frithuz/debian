check 5.3.1.2 "libpam-modules installed" all_installed libpam-modules
check 5.3.1.3 "libpam-pwquality installed" all_installed libpam-pwquality
in_pam() { local f; for f in "${@:2}"; do grep -Eq "^[^#]*\b$1\.so\b" "$(pam_file "$f")" 2>/dev/null || { echo "$1 not in $f"; return 1; }; done; }
check 5.3.2.1 "pam_unix enabled" in_pam pam_unix common-auth common-account common-password common-session
