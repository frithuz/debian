fi

check 5.2.1 "sudo installed" all_installed sudo
sudoers_all() { cat "$R/etc/sudoers" "$R"/etc/sudoers.d/* 2>/dev/null | grep -v '^[[:space:]]*#'; }
sudo_pty() { sudoers_all | grep -Eq '^[[:space:]]*Defaults([[:space:]]|,).*\buse_pty\b' || { echo "no Defaults use_pty"; return 1; }; }
sudo_log() { sudoers_all | grep -Eq '^[[:space:]]*Defaults([[:space:]]|,).*\blogfile=' || { echo "no Defaults logfile="; return 1; }; }
sudo_reauth() { ! sudoers_all | grep -Eq '!authenticate' || { echo "!authenticate used"; return 1; }; }
sudo_timeout() {
    local t; t=$(sudoers_all | grep -oE 'timestamp_timeout=-?[0-9]+' | tail -1 | cut -d= -f2)
    [ -z "$t" ] || num_between "$t" 0 15 || { echo "timestamp_timeout=$t"; return 1; }
}
su_restricted() {
    local g; g=$(grep -E '^[[:space:]]*auth[[:space:]]+(required|requisite)[[:space:]]+pam_wheel\.so.*use_uid.*group=' "$(pam_file su)" | grep -oE 'group=[^[:space:]]+' | cut -d= -f2 | head -1)
    [ -n "$g" ] || { echo "/etc/pam.d/su has no pam_wheel.so use_uid group=..."; return 1; }
    local members; members=$(awk -F: -v g="$g" '$1==g {print $4}' "$R/etc/group")
    [ -z "$members" ] || { echo "group $g has members: $members"; return 1; }
}
check 5.2.2 "sudo uses a pty" sudo_pty
check 5.2.3 "sudo log file" sudo_log
manual 5.2.4 "users must provide a password for sudo" "Level 2: the single admin uses NOPASSWD (key-only accounts have no password)"
check 5.2.5 "sudo re-authentication not disabled globally" sudo_reauth
check 5.2.6 "sudo timestamp_timeout <= 15 min" sudo_timeout
check 5.2.7 "su restricted to an empty group" su_restricted

