#!/usr/bin/env bash
# Keep a local os-release override current with Debian's vendor metadata.
set -euo pipefail
root=${1:-}
vendor=$root/usr/lib/os-release
version=$(
    # shellcheck source=/dev/null
    . "$vendor"
    printf '%s\n' "${VERSION_ID:?Debian VERSION_ID is missing}"
)
[[ $version =~ ^[0-9]+([.][0-9]+)*$ ]] || {
    echo "ERROR: unexpected Debian version: $version" >&2; exit 1;
}

tmp=$(mktemp "$root/etc/os-release.frithuz.XXXXXX")
trap 'rm -f "$tmp"' EXIT
{
    # Keep vendor identifiers, versions, codenames and support links unchanged.
    awk '!/^(PRETTY_NAME|VARIANT|VARIANT_ID)=/' "$vendor"
    printf 'PRETTY_NAME="Frithuz - Debian %s"\n' "$version"
    printf 'VARIANT="Frithuz"\nVARIANT_ID=frithuz\n'
} > "$tmp"
chmod 0644 "$tmp"
if ! cmp -s "$tmp" "$root/etc/os-release"; then
    mv "$tmp" "$root/etc/os-release"
    # Update existing boot menus after a Debian release upgrade. During image
    # construction the installer generates GRUB later, after all settings.
    if [[ -z $root && -f /boot/grub/grub.cfg ]]; then
        update-grub
    fi
fi
