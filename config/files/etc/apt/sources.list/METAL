# Apt sources used DURING the install (class SERVER). The mirror and the
# optional snapshot pin come from class/SERVER.var.
deb {%apt_opts%}{%apt_base%} {%release%} main contrib non-free non-free-firmware
deb {%apt_opts%}{%apt_base%} {%release%}-updates main contrib non-free non-free-firmware
deb {%apt_opts%}{%apt_sec%} {%secsuite%} main contrib non-free non-free-firmware

# Kernel and NIC firmware for recent physical hardware.
deb {%apt_opts%}{%apt_base%} {%release%}-backports main non-free-firmware
