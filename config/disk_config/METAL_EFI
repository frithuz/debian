# Physical server, UEFI, GPT + LVM, CIS-style separate mounts.
# WIPES disk1 (the eligible internal disk selected by partition.METAL.sh).
# USB, removable, read-only, mounted and undersized disks are excluded.
# Interactive installs show a disk selector. Needs >= 56 GiB.
#
# The VG is deliberately not filled: grow LVs later with
#   lvextend -r -L +10G <volume-group>/var
# The partition hook chooses vg0, vg1, ... to avoid names on other disks.
#
# p=<partlabel> <mountpoint> <size> <fs type> <mount options> <misc options>

disk_config disk1 disklabel:gpt bootable:1 fstabkey:uuid align-at:1M

p=efi    /boot/efi 512M  vfat  rw,umask=0077
p=boot   /boot     1G    ext4  rw,noatime,nodev,nosuid
p=system -         53G-  -     -

disk_config lvm fstabkey:uuid

vg vg0 disk1.3
vg0-root   /              35G   ext4  rw,noatime,errors=remount-ro
vg0-var    /var            4G   ext4  rw,noatime,nodev,nosuid
vg0-log    /var/log        2G   ext4  rw,noatime,nodev,nosuid,noexec
vg0-audit  /var/log/audit  1G   ext4  rw,noatime,nodev,nosuid,noexec
# Native development tools need room for both installer staging and releases.
vg0-home   /home           8G   ext4  rw,noatime,nodev,nosuid
vg0-tmp    /tmp            2G   ext4  rw,noatime,nodev,nosuid,noexec
