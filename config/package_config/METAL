PACKAGES install-norec
lvm2
mdadm
smartmontools
ethtool
lm-sensors
ipmitool

# CPU microcode exists only for x86
PACKAGES install-norec AMD64
intel-microcode amd64-microcode

# Firmware for common server NICs/RAID. Needs non-free-firmware in the
# build's apt sources (it is in FAI's default /etc/fai/apt/sources.list).
# No recommends: they would add GPU firmware and USB Wi-Fi dongle firmware.
PACKAGES install-norec
firmware-linux-free
firmware-misc-nonfree
firmware-bnx2 firmware-bnx2x
firmware-realtek/trixie-backports
firmware-netronome firmware-netxen firmware-qlogic
firmware-intel-misc        # Intel E810 (ice) DDP packages, QAT
firmware-mediatek          # MediaTek/Ralink Wi-Fi and Bluetooth on home machines
