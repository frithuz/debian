#!/usr/bin/env bash
# Use Debian's stock pam_motd flow, preserving the rest of both PAM stacks.
set -euo pipefail
"$FAI/bin/check-motd-env" "${MOTD_ENV:-}"
fcopy -m root,root,0755 /etc/update-motd.d/05-frithuz
touch "$target/etc/environment"
sed -i '/^ENV=/d' "$target/etc/environment"
printf 'ENV=%s\n' "$MOTD_ENV" >> "$target/etc/environment"
chown root:root "$target/etc/environment"
chmod 0644 "$target/etc/environment"
install -o root -g root -m 0644 /dev/null "$target/etc/motd"
if [[ -e $target/etc/update-motd.d/10-uname ]]; then
    chmod 0644 "$target/etc/update-motd.d/10-uname"
fi
for stack in sshd login; do
    # Fail if Debian's PAM integration changes, rather than replacing a whole
    # authentication stack. Leave the package's lines and their order intact.
    grep -Eq '^session[[:space:]]+optional[[:space:]]+pam_motd\.so[[:space:]]+motd=/run/motd.dynamic[[:space:]]*$' \
        "$target/etc/pam.d/$stack"
    grep -Eq '^session[[:space:]]+optional[[:space:]]+pam_motd\.so[[:space:]]+noupdate[[:space:]]*$' \
        "$target/etc/pam.d/$stack"
done
