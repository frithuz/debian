#!/usr/bin/env bash
# CIS 1.4.1: bootloader password. Boot entries stay --unrestricted so machines
# boot unattended; the password only guards editing entries / the grub shell.
# grub.cfg itself gets 0600 (1.4.2) from grub-mkconfig (umask 077) and LAST/92-cis-check.

error=0; trap 'error=$(($?>$error?$?:$error))' ERR # save maximum error code

# The hash comes from a file, never a variable: FAI dumps all variables into
# variables.log. config/secrets/ is gitignored (see README "Setting the GRUB password").
hash=''
secret=$FAI/secrets/grub-password.hash
if [ -r "$secret" ]; then
    hash=$(grep -m1 -oE 'grub\.pbkdf2\.[^[:space:]]+' "$secret" || true)
    [ -n "$hash" ] || { echo "ERROR: $secret has no grub.pbkdf2... hash" >&2; exit 1; }
fi
if [ -z "$hash" ]; then
    pw=$(head -c 48 /dev/urandom | base64 -w0)
    hash=$(printf '%s\n%s\n' "$pw" "$pw" | $ROOTCMD grub-mkpasswd-pbkdf2 | awk '/grub\.pbkdf2/ {print $NF}')
    unset pw
fi
[[ $hash == grub.pbkdf2.* ]] || { echo "ERROR: no usable grub password hash" >&2; exit 1; }

{
    echo '#!/bin/sh'
    echo '# Managed by FAI (class HARDEN), CIS 1.4.1. Hash from config/secrets/grub-password.hash, or random.'
    echo "echo 'set superusers=\"grubadmin\"'"
    echo "echo 'password_pbkdf2 grubadmin $hash'"
} > $target/etc/grub.d/01_cis_password
chmod 0700 $target/etc/grub.d/01_cis_password

# /etc/grub.d/10_linux is a conffile, so this edit survives grub upgrades.
fai-sed 's/^CLASS="--class gnu-linux --class gnu --class os"$/CLASS="--class gnu-linux --class gnu --class os --unrestricted"/' /etc/grub.d/10_linux
grep -q -- '--unrestricted' $target/etc/grub.d/10_linux || { echo "ERROR: could not mark boot entries --unrestricted" >&2; error=1; }

exit $error
