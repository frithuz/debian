#!/usr/bin/env bash
# Package installation has finished and all SERVER/HARDEN/CLOUD/METAL settings
# are in place. Generate initramfs once per kernel, before GRUB searches /boot.
set -euo pipefail

[[ $FAI_ACTION == install || $FAI_ACTION == dirinstall ]] || exit 0

# Either provider may have been installed after the diversions were added.
# Remove both stubs and diversions, including the one for an absent provider.
for generator in /usr/sbin/update-initramfs /usr/bin/dracut; do
    rm "$target$generator"
    $ROOTCMD dpkg-divert --local --remove --rename \
        --divert "$generator.fai-original" "$generator"
done
if [[ -x $target/usr/bin/dracut ]]; then
    provider=dracut
elif [[ -x $target/usr/sbin/update-initramfs ]]; then
    provider=initramfs-tools
else
    echo "ERROR: no initramfs generator installed" >&2
    exit 1
fi

# Use an explicit version for every installed kernel, including kernels in the
# base. initramfs-tools -u -k all ignores initrds that haven't been created yet.
shopt -s nullglob
kernels=("$target"/boot/vmlinuz-*)
if (( ${#kernels[@]} == 0 )); then
    echo "ERROR: no installed kernels to generate initramfs for" >&2
    exit 1
fi
for kernel in "${kernels[@]}"; do
    version=${kernel##*/vmlinuz-}
    if [[ $provider == dracut ]]; then
        # Match Debian's /etc/kernel/postinst.d/dracut invocation.
        $ROOTCMD dracut -q --force "/boot/initrd.img-$version" "$version"
    else
        $ROOTCMD update-initramfs -c -k "$version"
    fi
    test -s "$target/boot/initrd.img-$version"
done
